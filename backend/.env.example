# Backend configuration
# Copy to .env and adjust values for your environment.

# PostgreSQL connection string
# Local docker setup: postgresql://school:school@localhost:5432/smart_school
DATABASE_URL=postgresql://school:school@localhost:5432/smart_school

# Use "true" when not in a trusted local network (managed DBs like Neon/Railway)
DATABASE_SSL=false

# Server
PORT=5000
NODE_ENV=development

# JWT signing secret (generate a long random value, e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# OTP delivery: "console" logs codes to the server console (dev).
# "email" requires SMTP settings below.
OTP_DELIVERY=console

# SMTP (only used when OTP_DELIVERY=email or NOTIFICATIONS_EMAIL=true)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Smart School Connect <no-reply@example.com>

# Dev-only: skip strict auth when true (never enable in production)
DEV_BYPASS_AUTH=false

# AI Assistant - free LLM options
# "groq" (default): free API key from https://console.groq.com
#   set GROQ_API_KEY and optionally GROQ_MODEL
# "ollama": fully local and free, no key needed.
#   install from https://ollama.com then run: ollama pull llama3.1
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1