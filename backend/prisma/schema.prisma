// Student Peer Evaluations
model StudentPeerEvaluation {
  evaluation_id     Int       @id @default(autoincrement()) @map("evaluation_id")
  student_id        Int       @map("student_id") // Student being evaluated
  evaluator_id      Int       @map("evaluator_id") // Student doing the evaluation
  class_id          Int       @map("class_id")
  term              String    @db.VarChar(20)
  academic_year     String    @db.VarChar(20)
  teamwork_score    Decimal   @db.Decimal(3, 2)
  participation_score Decimal @db.Decimal(3, 2)
  collaboration_score Decimal @db.Decimal(3, 2)
  respect_score     Decimal   @db.Decimal(3, 2)
  overall_rating    Decimal   @db.Decimal(3, 2)
  comments          String?   @db.Text
  is_anonymous      Boolean   @default(true)
  submitted_at      DateTime  @default(now())

  evaluated_student Student   @relation("StudentEvaluated", fields: [student_id], references: [student_id], onDelete: Cascade)
  evaluator_student Student   @relation("StudentEvaluator", fields: [evaluator_id], references: [student_id], onDelete: Cascade)

  @@unique([student_id, evaluator_id, term, academic_year])
  @@map("student_peer_evaluations")
}

// ----------------------------
// 16. STUDENT-SPECIFIC TABLES
// ----------------------------

// Student Notes
model StudentNote {
  note_id          Int       @id @default(autoincrement()) @map("note_id")
  student_id       Int       @map("student_id")
  title            String    @db.VarChar(200)
  content          String    @db.Text
  subject          String?   @db.VarChar(100)
  tags             String[]  @db.VarChar(50)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @default(now()) @updatedAt

  student          Student   @relation(fields: [student_id], references: [student_id], onDelete: Cascade)

  @@index([student_id])
  @@map("student_notes")
}

// AI Books
model AIBook {
  book_id          Int       @id @default(autoincrement()) @map("book_id")
  title            String    @db.VarChar(200)
  subject_id       Int?      @map("subject_id")
  grade_level      Int       // 9, 10, 11, 12
  description      String?   @db.Text
  content          Json      // Book content structure
  author           String?   @db.VarChar(100)
  cover_image_url  String?   @db.Text
  is_active        Boolean   @default(true)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @default(now()) @updatedAt

  subject          Subject?  @relation(fields: [subject_id], references: [subject_id], onDelete: SetNull)
  book_progress    BookProgress[]
  book_quizzes     BookQuiz[]

  @@map("ai_books")
}

model BookProgress {
  progress_id      Int       @id @default(autoincrement()) @map("progress_id")
  book_id          Int       @map("book_id")
  student_id       Int       @map("student_id")
  current_page     Int       @default(0)
  total_pages      Int       @default(0)
  completion_percentage Decimal @default(0) @db.Decimal(5, 2)
  last_read_at     DateTime  @default(now())
  created_at       DateTime  @default(now())
  updated_at       DateTime  @default(now()) @updatedAt

  book             AIBook    @relation(fields: [book_id], references: [book_id], onDelete: Cascade)
  student          Student   @relation(fields: [student_id], references: [student_id], onDelete: Cascade)

  @@unique([book_id, student_id])
  @@map("book_progress")
}

model BookBookmark {
  bookmark_id      Int       @id @default(autoincrement()) @map("bookmark_id")
  book_id          Int       @map("book_id")
  student_id       Int       @map("student_id")
  page_number      Int
  section_title    String?   @db.VarChar(200)
  note             String?   @db.Text
  created_at       DateTime  @default(now())

  student          Student   @relation(fields: [student_id], references: [student_id], onDelete: Cascade)

  @@unique([book_id, student_id, page_number])
  @@map("book_bookmarks")
}

model BookHighlight {
  highlight_id     Int       @id @default(autoincrement()) @map("highlight_id")
  book_id          Int       @map("book_id")
  student_id       Int       @map("student_id")
  page_number      Int
  text_content     String    @db.Text
  color            String    @default("yellow") @db.VarChar(20)
  note             String?   @db.Text
  created_at       DateTime  @default(now())

  student          Student   @relation(fields: [student_id], references: [student_id], onDelete: Cascade)

  @@map("book_highlights")
}

model BookAnnotation {
  annotation_id    Int       @id @default(autoincrement()) @map("annotation_id")
  book_id          Int       @map("book_id")
  student_id       Int       @map("student_id")
  page_number      Int
  annotation_type  String    @db.VarChar(20) // NOTE, QUESTION, SUMMARY
  content          String    @db.Text
  created_at       DateTime  @default(now())
  updated_at       DateTime  @default(now()) @updatedAt

  student          Student   @relation(fields: [student_id], references: [student_id], onDelete: Cascade)

  @@map("book_annotations")
}

model BookQuiz {
  quiz_id          Int       @id @default(autoincrement()) @map("quiz_id")
  book_id          Int       @map("book_id")
  title            String    @db.VarChar(200)
  questions        Json      // Array of quiz questions
  passing_score    Decimal   @db.Decimal(5, 2)
  created_at       DateTime  @default(now())

  book             AIBook    @relation(fields: [book_id], references: [book_id], onDelete: Cascade)
  quiz_attempts    QuizAttempt[]

  @@map("book_quizzes")
}

model QuizAttempt {
  attempt_id       Int       @id @default(autoincrement()) @map("attempt_id")
  quiz_id          Int       @map("quiz_id")
  student_id       Int       @map("student_id")
  answers          Json      // Student's answers
  score            Decimal   @db.Decimal(5, 2)
  percentage       Decimal   @db.Decimal(5, 2)
  passed           Boolean   @default(false)
  attempted_at     DateTime  @default(now())

  quiz             BookQuiz  @relation(fields: [quiz_id], references: [quiz_id], onDelete: Cascade)
  student          Student   @relation(fields: [student_id], references: [student_id], onDelete: Cascade)

  @@map("quiz_attempts")
}

// Student Notification Preferences
model StudentNotificationPreference {
  preference_id     Int       @id @default(autoincrement()) @map("preference_id")
  student_id        Int       @unique @map("student_id")
  email_grades      Boolean   @default(true)
  email_attendance  Boolean   @default(true)
  email_conduct     Boolean   @default(true)
  email_assignments Boolean   @default(true)
  email_announcements Boolean @default(true)
  sms_grades        Boolean   @default(false)
  sms_attendance    Boolean   @default(false)
  sms_conduct       Boolean   @default(false)
  sms_assignments   Boolean   @default(false)
  sms_announcements Boolean   @default(false)
  in_app_grades     Boolean   @default(true)
  in_app_attendance Boolean   @default(true)
  in_app_conduct    Boolean   @default(true)
  in_app_assignments Boolean @default(true)
  in_app_announcements Boolean @default(true)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @default(now()) @updatedAt

  student          Student   @relation(fields: [student_id], references: [student_id], onDelete: Cascade)

  @@map("student_notification_preferences")
}

// Student Login History
model StudentLoginHistory {
  login_id          Int       @id @default(autoincrement()) @map("login_id")
  student_id        Int       @map("student_id")
  login_time        DateTime  @default(now())
  logout_time       DateTime?
  ip_address        String?   @db.VarChar(50)
  user_agent        String?   @db.Text
  device_type       String?   @db.VarChar(50) // MOBILE, DESKTOP, TABLET
  login_status      String    @default("SUCCESS") @db.VarChar(20) // SUCCESS, FAILED

  student          Student   @relation(fields: [student_id], references: [student_id], onDelete: Cascade)

  @@map("student_login_history")
}

// Student Profile Settings
model StudentProfile {
  profile_id        Int       @id @default(autoincrement()) @map("profile_id")
  student_id        Int       @unique @map("student_id")
  phone_number      String?   @db.VarChar(20)
  email_address     String?   @db.VarChar(100)
  home_address      String?   @db.Text
  profile_picture_url String?  @db.Text
  bio               String?   @db.Text
  interests         String[]  @db.VarChar(50)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @default(now()) @updatedAt

  student          Student   @relation(fields: [student_id], references: [student_id], onDelete: Cascade)

  @@map("student_profiles")
}

// ----------------------------
// 17. ONLINE LEARNING SYSTEM
// ----------------------------

// Virtual Classes
model VirtualClass {
  virtual_class_id Int       @id @default(autoincrement()) @map("virtual_class_id")
  class_subject_id Int       @map("class_subject_id")
  title            String    @db.VarChar(200)
  description      String?   @db.Text
  meeting_link     String    @db.Text // Zoom/Google Meet link
  meeting_id       String?   @db.VarChar(100) // Meeting ID
  meeting_password String?   @db.VarChar(50)
  is_recurring     Boolean   @default(false)
  recurring_pattern String?  @db.VarChar(50) // DAILY, WEEKLY, BIWEEKLY
  max_participants Int?
  is_active        Boolean   @default(true)
  created_by       Int       @map("created_by")
  created_at       DateTime  @default(now())
  updated_at       DateTime  @default(now()) @updatedAt

  class_subject    ClassSubject @relation(fields: [class_subject_id], references: [class_subject_id], onDelete: Cascade)
  live_sessions    LiveSession[]

  @@map("virtual_classes")
}

// Live Sessions
model LiveSession {
  session_id       Int       @id @default(autoincrement()) @map("session_id")
  virtual_class_id Int       @map("virtual_class_id")
  title            String    @db.VarChar(200)
  scheduled_start  DateTime
  scheduled_end    DateTime
  actual_start     DateTime?
  actual_end       DateTime?
  status           String    @default("SCHEDULED") @db.VarChar(20) // SCHEDULED, LIVE, ENDED, CANCELLED
  recording_url    String?   @db.Text
  chat_enabled     Boolean   @default(true)
  recording_enabled Boolean  @default(false)
  notes            String?   @db.Text
  created_at       DateTime  @default(now())
  updated_at       DateTime  @default(now()) @updatedAt

  virtual_class    VirtualClass @relation(fields: [virtual_class_id], references: [virtual_class_id], onDelete: Cascade)
  session_attendances SessionAttendance[]

  @@map("live_sessions")
}

// Session Attendance
model SessionAttendance {
  attendance_id    Int       @id @default(autoincrement()) @map("attendance_id")
  session_id       Int       @map("session_id")
  student_id       Int       @map("student_id")
  join_time        DateTime?
  leave_time       DateTime?
  duration_minutes Int?
  attended         Boolean   @default(false)
  engagement_score Decimal?  @db.Decimal(3, 2) // Based on participation
  notes            String?   @db.Text
  created_at       DateTime  @default(now())

  session          LiveSession @relation(fields: [session_id], references: [session_id], onDelete: Cascade)
  student          Student   @relation(fields: [student_id], references: [student_id], onDelete: Cascade)

  @@unique([session_id, student_id])
  @@map("session_attendances")
}

// Course Materials (for online learning)
model CourseMaterial {
  material_id      Int       @id @default(autoincrement()) @map("material_id")
  class_subject_id Int       @map("class_subject_id")
  title            String    @db.VarChar(200)
  description      String?   @db.Text
  material_type    String    @db.VarChar(50) // VIDEO, PDF, DOCUMENT, LINK, AUDIO
  file_url         String    @db.Text
  file_size        Int?      // in bytes
  duration_minutes Int?      // For videos/audio
  order            Int       @default(0)
  is_published     Boolean   @default(true)
  created_by       Int       @map("created_by")
  created_at       DateTime  @default(now())
  updated_at       DateTime  @default(now()) @updatedAt

  class_subject    ClassSubject @relation(fields: [class_subject_id], references: [class_subject_id], onDelete: Cascade)

  @@map("course_materials")
}

// Student Progress on Course Materials
model MaterialProgress {
  progress_id      Int       @id @default(autoincrement()) @map("progress_id")
  material_id      Int       @map("material_id")
  student_id       Int       @map("student_id")
  completed        Boolean   @default(false)
  completion_percentage Decimal @default(0) @db.Decimal(5, 2)
  last_accessed    DateTime  @default(now())
  time_spent_minutes Int      @default(0)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @default(now()) @updatedAt

  student          Student   @relation(fields: [student_id], references: [student_id], onDelete: Cascade)

  @@unique([material_id, student_id])
  @@map("material_progress")
}

// Discussion Forums
model DiscussionForum {
  forum_id         Int       @id @default(autoincrement()) @map("forum_id")
  class_subject_id Int       @map("class_subject_id")
  title            String    @db.VarChar(200)
  description      String?   @db.Text
  is_active        Boolean   @default(true)
  created_by       Int       @map("created_by")
  created_at       DateTime  @default(now())
  updated_at       DateTime  @default(now()) @updatedAt

  class_subject    ClassSubject @relation(fields: [class_subject_id], references: [class_subject_id], onDelete: Cascade)
  forum_posts      ForumPost[]

  @@map("discussion_forums")
}

model ForumPost {
  post_id          Int       @id @default(autoincrement()) @map("post_id")
  forum_id         Int       @map("forum_id")
  student_id       Int?      @map("student_id")
  teacher_id       Int?      @map("teacher_id")
  parent_post_id   Int?      @map("parent_post_id")
  content          String    @db.Text
  is_pinned        Boolean   @default(false)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @default(now()) @updatedAt

  forum            DiscussionForum @relation(fields: [forum_id], references: [forum_id], onDelete: Cascade)
  student          Student?   @relation(fields: [student_id], references: [student_id], onDelete: Cascade)
  replies          ForumPost[] @relation("ForumPostReplies")
  parent_post      ForumPost? @relation("ForumPostReplies", fields: [parent_post_id], references: [post_id], onDelete: SetNull)

  @@map("forum_posts")
}

// ----------------------------
// 18. TEACHER-SPECIFIC TABLES
// ----------------------------

// Teacher Settings & Preferences
model TeacherSettings {
  settings_id      Int       @id @default(autoincrement()) @map("settings_id")
  teacher_id       Int       @unique @map("teacher_id")
  grading_rubric   Json?     // Custom grading rubric preferences
  assignment_defaults Json?   // Default assignment settings
  notification_preferences Json?
  teaching_preferences Json?  // Teaching style preferences
  timezone         String    @default("Africa/Addis_Ababa") @db.VarChar(50)
  language         String    @default("en") @db.VarChar(10)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @default(now()) @updatedAt

  teacher          Teacher   @relation(fields: [teacher_id], references: [teacher_id], onDelete: Cascade)

  @@map("teacher_settings")
}
