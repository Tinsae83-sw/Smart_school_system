// ============================================================
// SMART SCHOOL CONNECT - PRISMA SCHEMA
// PostgreSQL 15+
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ----------------------------
// ENUMS
// ----------------------------
enum UserRole {
  SUPER_ADMIN
  ADMIN
  PRINCIPAL
  VP_ACADEMIC
  VP_ADMINISTRATION
  DEPARTMENT_HEAD
  TEACHER
  STUDENT
  PARENT
  PTSA_REPRESENTATIVE
  SIC_MEMBER
  NON_ACADEMIC_STAFF
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum NotificationType {
  ASSIGNMENT
  ATTENDANCE
  GRADE
  SYSTEM
  MESSAGE
  PAYMENT
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum AdminLevel {
  SUPER
  SCHOOL
  DEPARTMENT
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// Academic degree and gender enums for teachers
enum DegreeLevel {
  BACHELOR
  MASTER
  PHD
  DIPLOMA
  OTHER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// ----------------------------
// 1. USERS (base table)
// ----------------------------
model User {
  user_id               Int       @id @default(autoincrement()) @map("user_id")
  full_name             String    @db.VarChar(100)
  email                 String    @unique @db.VarChar(100)
  phone_number          String?   @db.VarChar(20)
  password_hash         String    @db.VarChar(255)
  role                  UserRole
  is_active             Boolean   @default(true)
  created_at            DateTime  @default(now())
  last_login            DateTime?
  profile_picture_url   String?   @db.Text
  preferred_language    String    @default("en") @db.VarChar(20)

  administrator         Administrator?
  principal             Principal?
  vp_academic           VPAcademic?
  vp_administration     VPAdministration?
  department_head       DepartmentHead?
  teacher               Teacher?
  student               Student?
  parent                Parent?
  ptsa_representative   PTSARepresentative?
  sic_member            SICMember?
  non_academic_staff    NonAcademicStaff?
  sent_messages         Message[]         @relation("SenderMessages")
  received_messages     Message[]         @relation("ReceiverMessages")
  notifications         Notification[]
  audit_logs            AuditLog[]
  user_sessions         UserSession[]
  reports               Report[]
  dashboards            Dashboard?
  reviewed_lesson_plans LessonPlan[]      @relation("LessonPlanReviewer")
  resource_requests     ResourceRequest[] @relation("ResourceRequester")
  reviewed_resource_requests ResourceRequest[] @relation("ResourceRequestReviewer")
  created_exams         Exam[]            @relation("ExamCreator")
  approved_exams        Exam[]            @relation("ExamApprover")
  evaluation_forms      PeerEvaluationForm[] @relation("EvaluationFormCreator")
  created_meetings      DepartmentMeeting[] @relation("MeetingCreator")
  meeting_attendances  MeetingAttendee[]  @relation("MeetingAttendee")
  created_minutes       MeetingMinutes[]  @relation("MinutesCreator")
  intervention_plans    InterventionPlan[] @relation("InterventionCreator")
  curriculum_maps       CurriculumMap[]    @relation("CurriculumCreator")
  ptsa_meetings_created PTSAMeeting[]    @relation("PTSAMeetingCreator")
  ptsa_meetings_approved PTSAMeeting[]   @relation("PTSAMeetingApprover")
  ptsa_meeting_attendances PTSAMeetingAttendee[] @relation("PTSAMeetingAttendee")
  ptsa_feedback_submitted PTSAFeedback[]  @relation("PTSAFeedbackSubmitter")
  ptsa_feedback_responded PTSAFeedback[]  @relation("PTSAFeedbackResponder")
  budget_advisories_submitted BudgetAdvisory[] @relation("BudgetAdvisorySubmitter")
  budget_advisories_reviewed BudgetAdvisory[] @relation("BudgetAdvisoryReviewer")
  sip_feedback_submitted SIPFeedback[]    @relation("SIPFeedbackSubmitter")
  parent_surveys_created ParentSurvey[]   @relation("ParentSurveyCreator")
  grievances_submitted  Grievance[]       @relation("GrievanceSubmitter")
  grievances_assigned   Grievance[]      @relation("GrievanceAssignee")
  ptsa_fund_transactions_created PTSAFundTransaction[] @relation("PTSAFundTransactionCreator")
  ptsa_announcements_created PTSAAnnouncement[] @relation("PTSAAnnouncementCreator")

  @@map("users")
}

// ----------------------------
// 2. ROLE-SPECIFIC EXTENSIONS
// ----------------------------
model Administrator {
  admin_id      Int       @id @default(autoincrement()) @map("admin_id")
  user_id       Int       @unique @map("user_id")
  employee_id   String    @unique @db.VarChar(20)
  access_level  AdminLevel

  user          User      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("administrators")
}

model Principal {
  principal_id    Int       @id @default(autoincrement()) @map("principal_id")
  user_id         Int       @unique @map("user_id")
  employee_id     String    @unique @db.VarChar(20)
  appointment_date DateTime? @db.Date

  user            User      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("principals")
}

model VPAcademic {
  vp_academic_id  Int       @id @default(autoincrement()) @map("vp_academic_id")
  user_id         Int       @unique @map("user_id")
  employee_id     String    @unique @db.VarChar(20)
  appointment_date DateTime? @db.Date

  user            User      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("vp_academic")
}

model VPAdministration {
  vp_admin_id     Int       @id @default(autoincrement()) @map("vp_admin_id")
  user_id         Int       @unique @map("user_id")
  employee_id     String    @unique @db.VarChar(20)
  appointment_date DateTime? @db.Date

  user            User      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("vp_administration")
}

model DepartmentHead {
  dept_head_id    Int       @id @default(autoincrement()) @map("dept_head_id")
  user_id         Int       @unique @map("user_id")
  employee_id     String    @unique @db.VarChar(20)
  department      String    @db.VarChar(100)
  appointment_date DateTime? @db.Date

  user            User      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("department_heads")
}

model PTSARepresentative {
  ptsa_rep_id    Int       @id @default(autoincrement()) @map("ptsa_rep_id")
  user_id        Int       @unique @map("user_id")
  term_start     DateTime? @db.Date
  term_end       DateTime? @db.Date
  position       String?   @db.VarChar(50)

  user           User      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("ptsa_representatives")
}

model SICMember {
  sic_member_id  Int       @id @default(autoincrement()) @map("sic_member_id")
  user_id        Int       @unique @map("user_id")
  role           String?   @db.VarChar(100)
  term_start     DateTime? @db.Date
  term_end       DateTime? @db.Date

  user           User      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("sic_members")
}

model Teacher {
  teacher_id      Int       @id @default(autoincrement()) @map("teacher_id")
  user_id         Int       @unique @map("user_id")
  employee_id     String    @unique @db.VarChar(20)
  department      String?   @db.VarChar(100)
  hire_date       DateTime? @db.Date
  degree_level    DegreeLevel? 
  gender          Gender?
  age             Int?
  experience_years Int?
  grade_levels    Int[]
  subjects        String[]

  user                User                @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  homeroom_classes    SchoolClass[]
  class_subjects      ClassSubject[]
  attendance_records  AttendanceRecord[]
  grades              Grade[]
  lesson_plans        LessonPlan[]
  resource_allocations ResourceAllocation[]
  exam_invigilations  ExamInvigilator[]
  peer_evaluations_as_evaluator PeerEvaluation[] @relation("PeerEvaluationEvaluator")
  peer_evaluations_as_evaluatee PeerEvaluation[] @relation("PeerEvaluationEvaluatee")
  teacher_settings    TeacherSettings?

  @@map("teachers")
}

model Student {
  student_id      Int       @id @default(autoincrement()) @map("student_id")
  user_id         Int       @unique @map("user_id")
  student_number  String    @unique @db.VarChar(20)
  enrollment_date DateTime  @db.Date
  current_class_id Int?     @map("current_class_id")
  date_of_birth   DateTime? @db.Date
  gender          String?   @db.VarChar(10)

  user                User                @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  current_class       SchoolClass?        @relation(fields: [current_class_id], references: [class_id], onDelete: SetNull)
  attendance_records  AttendanceRecord[]
  submissions         Submission[]
  student_parents     StudentParent[]
  payments            Payment[]
  performance_predictions PerformancePrediction[]
  transcripts         Transcript[]
  exam_results         ExamResult[] @relation("ExamResultStudent")
  intervention_plans   InterventionPlan[] @relation("InterventionStudent")
  student_notes       StudentNote[]
  book_progress       BookProgress[]
  book_bookmarks      BookBookmark[]
  book_highlights     BookHighlight[]
  book_annotations    BookAnnotation[]
  quiz_attempts       QuizAttempt[]
  notification_preferences StudentNotificationPreference?
  login_history       StudentLoginHistory[]
  student_profile     StudentProfile?
  peer_evaluations_received StudentPeerEvaluation[] @relation("StudentEvaluated")
  peer_evaluations_given StudentPeerEvaluation[] @relation("StudentEvaluator")
  session_attendances SessionAttendance[]
  material_progress  MaterialProgress[]
  forum_posts         ForumPost[]

  @@index([current_class_id])
  @@map("students")
}

model Parent {
  parent_id         Int       @id @default(autoincrement()) @map("parent_id")
  user_id           Int       @unique @map("user_id")
  relationship      String    @db.VarChar(20)
  address           String?   @db.Text
  preferred_language String?   @db.VarChar(20)

  user                User                @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  student_parents     StudentParent[]
  payments            Payment[]
  survey_responses    ParentSurveyResponse[] @relation("ParentSurveyResponse")

  @@map("parents")
}

// ----------------------------
// 3. ACADEMIC CORE
// ----------------------------
model SchoolClass {
  class_id            Int       @id @default(autoincrement()) @map("class_id")
  class_name          String    @db.VarChar(50)
  academic_year       String    @db.VarChar(20)
  homeroom_teacher_id Int       @map("homeroom_teacher_id")

  homeroom_teacher    Teacher             @relation(fields: [homeroom_teacher_id], references: [teacher_id], onDelete: Restrict)
  students            Student[]
  class_subjects      ClassSubject[]
  attendance_records  AttendanceRecord[]
  announcements       Announcement[]
  class_schedules     ClassSchedule[]

  @@map("school_classes")
}

model Subject {
  subject_id    Int       @id @default(autoincrement()) @map("subject_id")
  subject_name  String    @db.VarChar(100)
  subject_code  String    @unique @db.VarChar(20)

  class_subjects  ClassSubject[]
  class_schedules ClassSchedule[]
  curriculum_maps CurriculumMap[]
  ai_books        AIBook[]

  @@map("subjects")
}

model ClassSubject {
  class_subject_id Int     @id @default(autoincrement()) @map("class_subject_id")
  class_id         Int     @map("class_id")
  subject_id       Int     @map("subject_id")
  teacher_id       Int     @map("teacher_id")

  school_class      SchoolClass       @relation(fields: [class_id], references: [class_id], onDelete: Cascade)
  subject           Subject           @relation(fields: [subject_id], references: [subject_id], onDelete: Cascade)
  teacher           Teacher           @relation(fields: [teacher_id], references: [teacher_id], onDelete: Cascade)
  assignments       Assignment[]
  lesson_plans      LessonPlan[]
  exams             Exam[]
  virtual_classes   VirtualClass[]
  course_materials  CourseMaterial[]
  discussion_forums DiscussionForum[]

  @@unique([class_id, subject_id])
  @@map("class_subject")
}

// ----------------------------
// 4. ATTENDANCE
// ----------------------------
model AttendanceRecord {
  record_id   Int       @id @default(autoincrement()) @map("record_id")
  student_id  Int       @map("student_id")
  class_id    Int       @map("class_id")
  date        DateTime  @db.Date
  status      AttendanceStatus
  remarks     String?   @db.Text
  recorded_by Int       @map("recorded_by")
  created_at  DateTime  @default(now())
  updated_at  DateTime  @default(now()) @updatedAt

  student     Student   @relation(fields: [student_id], references: [student_id], onDelete: Cascade)
  school_class SchoolClass @relation(fields: [class_id], references: [class_id], onDelete: Cascade)
  teacher     Teacher   @relation(fields: [recorded_by], references: [teacher_id])

  @@unique([student_id, class_id, date])
  @@map("attendance_records")
}

// ----------------------------
// 5. ASSIGNMENTS & SUBMISSIONS & GRADES
// ----------------------------
model Assignment {
  assignment_id    Int       @id @default(autoincrement()) @map("assignment_id")
  class_subject_id Int       @map("class_subject_id")
  title            String    @db.VarChar(200)
  description      String?   @db.Text
  due_date         DateTime
  max_score        Decimal   @db.Decimal(5, 2)
  attachments      String[]
  allow_resubmission Boolean  @default(false)
  resubmission_deadline DateTime?
  max_resubmissions Int       @default(1)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @default(now()) @updatedAt

  class_subject    ClassSubject    @relation(fields: [class_subject_id], references: [class_subject_id], onDelete: Cascade)
  submissions      Submission[]

  @@map("assignments")
}

model Submission {
  submission_id Int       @id @default(autoincrement()) @map("submission_id")
  assignment_id Int       @map("assignment_id")
  student_id    Int       @map("student_id")
  submitted_at  DateTime  @default(now())
  file_url      String    @db.Text
  is_late       Boolean   @default(false)
  resubmission_number Int  @default(0)
  parent_submission_id Int? @map("parent_submission_id")
  feedback_viewed Boolean @default(false)

  assignment    Assignment  @relation(fields: [assignment_id], references: [assignment_id], onDelete: Cascade)
  student       Student     @relation(fields: [student_id], references: [student_id], onDelete: Cascade)
  grade         Grade?
  resubmissions Submission[] @relation("SubmissionResubmissions")
  parent_submission Submission? @relation("SubmissionResubmissions", fields: [parent_submission_id], references: [submission_id], onDelete: SetNull)

  @@unique([assignment_id, student_id, resubmission_number])
  @@map("submissions")
}

model Grade {
  grade_id      Int       @id @default(autoincrement()) @map("grade_id")
  submission_id Int       @unique @map("submission_id")
  score         Decimal   @db.Decimal(5, 2)
  letter_grade  String?   @db.Char(2)
  feedback      String?   @db.Text
  graded_by     Int       @map("graded_by")
  graded_at     DateTime  @default(now())

  submission    Submission  @relation(fields: [submission_id], references: [submission_id], onDelete: Cascade)
  teacher       Teacher     @relation(fields: [graded_by], references: [teacher_id])

  @@map("grades")
}

// ----------------------------
// 6. COMMUNICATION
// ----------------------------
model Message {
  message_id        Int       @id @default(autoincrement()) @map("message_id")
  sender_id         Int       @map("sender_id")
  receiver_id       Int       @map("receiver_id")
  content           String    @db.Text
  timestamp         DateTime  @default(now())
  is_read           Boolean   @default(false)
  attachment        String?   @db.Text
  parent_message_id Int?      @map("parent_message_id")

  sender            User      @relation("SenderMessages", fields: [sender_id], references: [user_id], onDelete: Cascade)
  receiver          User      @relation("ReceiverMessages", fields: [receiver_id], references: [user_id], onDelete: Cascade)
  parent_message    Message?  @relation("MessageThread", fields: [parent_message_id], references: [message_id], onDelete: SetNull)
  child_messages    Message[] @relation("MessageThread")

  @@map("messages")
}

model Notification {
  notification_id Int             @id @default(autoincrement()) @map("notification_id")
  user_id         Int             @map("user_id")
  type            NotificationType
  content         String          @db.VarChar(500)
  is_sent         Boolean         @default(false)
  sent_at         DateTime        @default(now())
  metadata        Json?

  user            User            @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("notifications")
}

// ----------------------------
// 7. REPORTS, DASHBOARDS, AI PREDICTIONS
// ----------------------------
model Report {
  report_id     Int       @id @default(autoincrement()) @map("report_id")
  generated_by  Int?      @map("generated_by")
  title         String    @db.VarChar(200)
  data          Json
  generated_at  DateTime  @default(now())

  user          User?     @relation(fields: [generated_by], references: [user_id], onDelete: SetNull)

  @@map("reports")
}

model Dashboard {
  dashboard_id  Int       @id @default(autoincrement()) @map("dashboard_id")
  user_id       Int       @unique @map("user_id")
  widget_config Json?

  user          User      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("dashboards")
}

model PerformancePrediction {
  prediction_id   Int         @id @default(autoincrement()) @map("prediction_id")
  student_id      Int         @map("student_id")
  predicted_grade String?     @db.VarChar(10)
  risk_level      RiskLevel?
  recommendation  String?     @db.Text
  generated_at    DateTime    @default(now())

  student         Student     @relation(fields: [student_id], references: [student_id], onDelete: Cascade)

  @@map("performance_predictions")
}

// ----------------------------
// 8. AUTHENTICATION & SECURITY
// ----------------------------
model OtpVerification {
  otp_id      Int       @id @default(autoincrement()) @map("otp_id")
  email       String    @db.VarChar(100)
  otp_code    String    @db.VarChar(6)
  expires_at  DateTime
  is_verified Boolean   @default(false)
  created_at  DateTime  @default(now())

  @@map("otp_verifications")
}

model UserSession {
  session_id    Int       @id @default(autoincrement()) @map("session_id")
  user_id       Int       @map("user_id")
  token         String    @unique @db.VarChar(255)
  login_time    DateTime  @default(now())
  last_activity DateTime  @default(now())
  ip_address    String?
  user_agent    String?   @db.Text

  user          User      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("user_sessions")
}

model AuditLog {
  log_id      Int       @id @default(autoincrement()) @map("log_id")
  user_id     Int?      @map("user_id")
  action      String    @db.VarChar(255)
  timestamp   DateTime  @default(now())
  ip_address  String?
  details     Json?

  user        User?     @relation(fields: [user_id], references: [user_id], onDelete: SetNull)

  @@map("audit_logs")
}

// ----------------------------
// 9. PAYMENT INTEGRATION
// ----------------------------
model Payment {
  payment_id      Int           @id @default(autoincrement()) @map("payment_id")
  parent_id       Int           @map("parent_id")
  student_id      Int           @map("student_id")
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("ETB") @db.VarChar(3)
  status          PaymentStatus @default(PENDING)
  transaction_id  String?       @db.VarChar(100)
  payment_method  String?       @db.VarChar(50)
  receipt_url     String?       @db.Text
  created_at      DateTime      @default(now())
  updated_at      DateTime      @default(now()) @updatedAt

  parent          Parent        @relation(fields: [parent_id], references: [parent_id], onDelete: Cascade)
  student         Student       @relation(fields: [student_id], references: [student_id], onDelete: Cascade)

  @@map("payments")
}

// ----------------------------
// 10. ADDITIONAL RELATIONSHIPS
// ----------------------------
model StudentParent {
  student_parent_id Int       @id @default(autoincrement()) @map("student_parent_id")
  student_id        Int       @map("student_id")
  parent_id         Int       @map("parent_id")
  relationship      String?   @db.VarChar(40)
  linked_at         DateTime  @default(now())

  student           Student   @relation(fields: [student_id], references: [student_id], onDelete: Cascade)
  parent            Parent    @relation(fields: [parent_id], references: [parent_id], onDelete: Cascade)

  @@unique([student_id, parent_id])
  @@map("student_parent")
}

model Announcement {
  announcement_id Int       @id @default(autoincrement()) @map("announcement_id")
  title           String    @db.VarChar(200)
  message         String    @db.Text
  created_by      Int?      @map("created_by")
  target_roles    String    @default("ALL") @db.VarChar(200)
  target_class_id Int?      @map("target_class_id")
  published_at    DateTime  @default(now())
  is_active       Boolean   @default(true)

  school_class    SchoolClass? @relation(fields: [target_class_id], references: [class_id], onDelete: SetNull)

  @@map("announcements")
}

model ClassSchedule {
  schedule_id   Int       @id @default(autoincrement()) @map("schedule_id")
  class_id      Int       @map("class_id")
  day_of_week   String    @db.VarChar(10)
  period        Int
  subject_id    Int       @map("subject_id")
  teacher_id    Int       @map("teacher_id")
  room_number   String?   @db.VarChar(50)
  start_time    DateTime  @db.Time
  end_time      DateTime  @db.Time

  school_class  SchoolClass @relation(fields: [class_id], references: [class_id], onDelete: Cascade)
  subject       Subject     @relation(fields: [subject_id], references: [subject_id], onDelete: Cascade)

  @@unique([class_id, day_of_week, period])
  @@map("class_schedules")
}

model Transcript {
  transcript_id Int       @id @default(autoincrement()) @map("transcript_id")
  student_id    Int       @map("student_id")
  generated_by  Int?      @map("generated_by")
  data          Json
  pdf_url       String?   @db.Text
  generated_at  DateTime  @default(now())

  student       Student   @relation(fields: [student_id], references: [student_id], onDelete: Cascade)

  @@map("transcripts")
}

// ----------------------------
// 11. DEPARTMENT HEAD SPECIFIC TABLES
// ----------------------------

// Lesson Plans
model LessonPlan {
  lesson_plan_id   Int       @id @default(autoincrement()) @map("lesson_plan_id")
  teacher_id       Int       @map("teacher_id")
  class_subject_id Int       @map("class_subject_id")
  title            String    @db.VarChar(200)
  objectives       String[]  @db.Text
  materials        String[]  @db.Text
  activities       String[]  @db.Text
  assessment       String?   @db.Text
  submitted_at     DateTime  @default(now())
  reviewed_at      DateTime?
  reviewed_by      Int?      @map("reviewed_by")
  status           String    @default("PENDING") @db.VarChar(20) // PENDING, APPROVED, REJECTED
  review_comments  String?   @db.Text
  week_number      Int?
  term             String    @db.VarChar(20)

  teacher          Teacher   @relation(fields: [teacher_id], references: [teacher_id], onDelete: Cascade)
  class_subject    ClassSubject @relation(fields: [class_subject_id], references: [class_subject_id], onDelete: Cascade)
  reviewer         User?     @relation("LessonPlanReviewer", fields: [reviewed_by], references: [user_id], onDelete: SetNull)

  @@map("lesson_plans")
}

// Resources
model Resource {
  resource_id      Int       @id @default(autoincrement()) @map("resource_id")
  name             String    @db.VarChar(200)
  type             String    @db.VarChar(50) // TEXTBOOK, LAB_EQUIPMENT, SOFTWARE, MATERIAL
  description      String?   @db.Text
  quantity         Int       @default(1)
  department       String    @db.VarChar(100)
  status           String    @default("AVAILABLE") @db.VarChar(20) // AVAILABLE, IN_USE, DAMAGED, REQUESTED
  created_at       DateTime  @default(now())
  updated_at       DateTime  @default(now()) @updatedAt

  resource_allocations ResourceAllocation[]
  resource_requests    ResourceRequest[]

  @@map("resources")
}

model ResourceAllocation {
  allocation_id    Int       @id @default(autoincrement()) @map("allocation_id")
  resource_id      Int       @map("resource_id")
  teacher_id       Int       @map("teacher_id")
  allocated_at     DateTime  @default(now())
  returned_at      DateTime?
  quantity         Int       @default(1)
  notes            String?   @db.Text

  resource         Resource  @relation(fields: [resource_id], references: [resource_id], onDelete: Cascade)
  teacher          Teacher   @relation(fields: [teacher_id], references: [teacher_id], onDelete: Cascade)

