# Backend API base URL — set to your deployed backend URL.
# In development, defaults to http://localhost:5000
NEXT_PUBLIC_API_BASE=http://localhost:5000

# Public site URL — used for sitemap.xml, robots.txt, and social meta tags.
# In development, defaults to http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 measurement ID (optional).
# Analytics only loads after a visitor accepts cookies in the consent banner.
# Leave empty to disable analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
